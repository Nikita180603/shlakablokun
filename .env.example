# Скопируйте в .env и заполните значения.
# copy .env.example .env

# Домен сайта без https:// и без слэша. Для Caddy + Let's Encrypt.
KD_DOMAIN=shop.example.com

# В контейнере слушаем все интерфейсы; снаружи режет Caddy.
KD_ADDR=0.0.0.0:4173

KD_ADMIN_USER=admin
KD_ADMIN_PASSWORD=change-me-strong-password

KD_SMTP_HOST=
KD_SMTP_PORT=587
KD_SMTP_USER=
KD_SMTP_PASSWORD=
KD_SMTP_FROM=
